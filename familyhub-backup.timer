# Daily SQLite backup. Install alongside familyhub-backup.service:
#   sudo cp familyhub-backup.{service,timer} /etc/systemd/system/
#   sudo systemctl enable --now familyhub-backup.timer
[Unit]
Description=Daily FamilyHub DB backup

[Timer]
OnCalendar=*-*-* 03:30:00
Persistent=true

[Install]
WantedBy=timers.target
