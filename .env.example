# FamilyHub environment — copy to `.env` and fill in. NEVER commit the real .env.
# (.env is already gitignored.) Everything here is optional: FamilyHub runs
# without any of it; each one just lights up a feature.

# --- AI quick-add (text + photo) -------------------------------------------
# Anthropic API key for natural-language quick-add and the vision flyer import.
# Get one at console.anthropic.com. Without it, quick-add/vision are disabled.
ANTHROPIC_API_KEY=
# Which Claude model every feature uses. Opus is sharpest (~1c per voice question,
# 3-5c with a web search). claude-haiku-5-5 is ~50x cheaper and still great for
# trivia, quick-add and email parsing; claude-sonnet-5-5 is the middle. Also set a
# monthly spend limit in the Anthropic console so it can never surprise you.
# FAMILYHUB_AI_MODEL=claude-opus-4-8

# --- Database ---------------------------------------------------------------
# SQLite only for now (Postgres is planned, not yet wired). Point FAMILYHUB_DB
# elsewhere to move the file — e.g. onto a Railway Volume so data survives deploys.
# FAMILYHUB_DB=familyhub.db
# FAMILYHUB_DB=/data/familyhub.db        # Railway volume mount (see docs/railway-deploy.md)

# --- Demo / test deploys ----------------------------------------------------
# SEED_DEMO=1 loads the sample family ON FIRST BOOT if the DB is empty, so a
# fresh cloud/test deploy isn't blank. Turn it OFF once you add real data.
# SEED_DEMO=1

# --- Access protection ------------------------------------------------------
# If set, changes (adding events, etc.) require this PIN via the X-FH-PIN header.
# Reads stay open by default so the wall always shows.
FAMILYHUB_PIN=
# Lock VIEWING too (not just edits): a login screen asks for the PIN before any
# data loads. Set this when the app is on a public URL (e.g. Railway) so nobody
# with the link can see your calendar. Needs FAMILYHUB_PIN to be set.
# FAMILYHUB_LOCK_READS=1
# Brute-force lockout tuning (optional; defaults shown):
# FAMILYHUB_MAX_FAILS=5     # wrong PIN guesses before a lockout
# FAMILYHUB_LOCKOUT=60      # lockout duration in seconds
# For real off-network exposure, prefer Tailscale over a public URL (docs/hardening.md).

# --- Night screen-off commands ----------------------------------------------
# How FamilyHub turns the wall screen off/on at night. Defaults to the Pi's
# vcgencmd. On the x86 kiosk (Ubuntu + Xorg, what setup/install-kiosk.sh sets
# up) use DPMS instead — the installer appends these two lines for you:
# FAMILYHUB_SCREEN_OFF_CMD=xset dpms force off
# FAMILYHUB_SCREEN_ON_CMD=xset dpms force on
# Pi default:
# FAMILYHUB_SCREEN_OFF_CMD=vcgencmd display_power 0
# FAMILYHUB_SCREEN_ON_CMD=vcgencmd display_power 1

# --- Voice assistant ----------------------------------------------------------
# Open questions go to Claude with web search (news, scores, store hours) — uses
# the same ANTHROPIC_API_KEY, nothing else to set up. Location steers "is X open"
# style answers. Set FAMILYHUB_VOICE_WEB=0 to keep the assistant offline-only.
# FAMILYHUB_CITY=Myrtle Beach
# FAMILYHUB_REGION=South Carolina
# FAMILYHUB_VOICE_WEB=1
# Local ears + voice on the wall (snap Chromium has no speech engine of its own).
# setup/install-voice.sh installs Whisper + Piper and writes these two lines.
# FAMILYHUB_STT_MODEL=base.en            # tiny.en (fastest) / base.en / small.en (best)
# FAMILYHUB_PIPER_VOICE=/home/hub/familyhub/models/piper/en_US-lessac-medium.onnx

# --- Spotify on the wall (the wall becomes an official Spotify device) ----------
# Same developer app you created for Home Assistant (developer.spotify.com → your app →
# Settings). Add http://127.0.0.1:8000/api/spotify/callback to its Redirect URIs.
# Then phone app → Settings → Spotify → Connect. Needs Spotify Premium.
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=
# SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/spotify/callback

# --- Email import ("magic email") -------------------------------------------
# Forward school newsletters / schedules / calendar invites to a mailbox and
# FamilyHub turns them into events you approve on the phone. Use a dedicated
# free Gmail + an APP PASSWORD (Google Account -> Security -> App passwords).
# Checked every 5 minutes. Needs ANTHROPIC_API_KEY for plain-text emails;
# .ics invites are parsed without AI.
# FAMILYHUB_MAIL_HOST=imap.gmail.com
# FAMILYHUB_MAIL_USER=familyhub.yourname@gmail.com
# FAMILYHUB_MAIL_PASS=
# FAMILYHUB_MAIL_FOLDER=INBOX

# --- Home Assistant (Phase 2 — smart home tab) ------------------------------
# Your HA server + a Long-Lived Access Token (HA profile -> Security).
# Stays server-side only; never sent to the browser. See docs/home-assistant-setup.md
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# Leave both blank to run the Home tab in DEMO mode (sample lights/alarm/scenes),
# or force demo even with a real HA by setting HA_DEMO=1.
# HA_DEMO=1

# LAN address of this box, used in doorbell pushes / Roku flashes so phones and TVs can load the snapshot
# (default: auto-detected IP + port 8000)
# FAMILYHUB_URL=http://192.168.1.50:8000

# Live-traffic drive times for the leave-by countdown (free key: developer.tomtom.com). Optional;
# without it FamilyHub uses Waze via Home Assistant, else drive times without traffic.
# TOMTOM_API_KEY=
