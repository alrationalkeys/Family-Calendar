# FamilyHub environment — copy to `.env` and fill in. NEVER commit the real .env.
# (.env is already gitignored.) Everything here is optional: FamilyHub runs
# without any of it; each one just lights up a feature.

# --- AI quick-add (text + photo) -------------------------------------------
# Anthropic API key for natural-language quick-add and the vision flyer import.
# Get one at console.anthropic.com. Without it, quick-add/vision are disabled.
ANTHROPIC_API_KEY=

# --- Database ---------------------------------------------------------------
# SQLite only for now (Postgres is planned, not yet wired). Point FAMILYHUB_DB
# elsewhere to move the file — e.g. onto a Railway Volume so data survives deploys.
# FAMILYHUB_DB=familyhub.db
# FAMILYHUB_DB=/data/familyhub.db        # Railway volume mount (see docs/railway-deploy.md)

# --- Demo / test deploys ----------------------------------------------------
# SEED_DEMO=1 loads the sample family ON FIRST BOOT if the DB is empty, so a
# fresh cloud/test deploy isn't blank. Turn it OFF once you add real data.
# SEED_DEMO=1

# --- Write protection -------------------------------------------------------
# If set, changes (adding events, etc.) require this PIN via the X-FH-PIN header.
# Reads stay open. For real off-network exposure, use Tailscale (see docs/hardening.md).
FAMILYHUB_PIN=
# Brute-force lockout tuning (optional; defaults shown):
# FAMILYHUB_MAX_FAILS=5     # wrong PIN tries before a device is locked out
# FAMILYHUB_LOCKOUT=60      # lockout duration in seconds

# --- Night screen-off commands (Raspberry Pi) -------------------------------
# How FamilyHub turns the wall backlight off/on at night. Defaults to the Pi's
# vcgencmd. Override for Wayland/labwc or a non-Pi host.
# FAMILYHUB_SCREEN_OFF_CMD=vcgencmd display_power 0
# FAMILYHUB_SCREEN_ON_CMD=vcgencmd display_power 1

# --- Home Assistant (Phase 2 — smart home tab) ------------------------------
# Your HA server + a Long-Lived Access Token (HA profile -> Security).
# Stays server-side only; never sent to the browser. See docs/home-assistant-setup.md
# HA_URL=http://homeassistant.local:8123
# HA_TOKEN=
# Leave both blank to run the Home tab in DEMO mode (sample lights/alarm/scenes),
# or force demo even with a real HA by setting HA_DEMO=1.
# HA_DEMO=1
